# Demo deployment environment

# Public URLs
FRONTEND_URL=https://eduvault-demo.example.com
BACKEND_URL=https://api.eduvault-demo.example.com
PUBLIC_BASE_URL=https://eduvault-demo.example.com
ALLOWED_ORIGINS=https://eduvault-demo.example.com,https://api.eduvault-demo.example.com,https://c2-app-012.eduvinuni.io.vn,https://c2-app-012-api.eduvinuni.io.vn

# Service ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_PORT=6333

# Database
DATABASE_PROVIDER=mysql
DATABASE_FALLBACK_SQLITE=false
MYSQL_HOST=mysql
MYSQL_DATABASE=eduvault
MYSQL_USER=eduvault
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-separate-strong-root-password
MYSQL_CONNECT_TIMEOUT_SECONDS=3
MYSQL_STARTUP_MAX_WAIT_SECONDS=45
MYSQL_STARTUP_BACKOFF_BASE_SECONDS=0.5
MYSQL_STARTUP_BACKOFF_MAX_SECONDS=5

# Object storage
MINIO_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_ACCESS_KEY=replace-with-minio-root-user-or-existing-s3-user
MINIO_SECRET_KEY=replace-with-minio-root-password-or-existing-s3-user-secret
MINIO_BUCKET=eduvault
MINIO_SECURE=false

# Vector store
QDRANT_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=eduvault_chunks
QDRANT_TOP_K=100

# Queue fallback for demo
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE=eduvault:demo:jobs

# Session / auth / JWT-compatible secrets
SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=43200
JWT_SECRET_KEY=replace-with-demo-jwt-secret
TOKEN_ENCRYPTION_KEY=replace-with-random-32-plus-char-secret
N8N_POLICY_SECRET=replace-with-demo-policy-secret

# Seed/demo users
EDUVAULT_SEED_PASSWORD_GV001=replace-with-demo-password-1
EDUVAULT_SEED_PASSWORD_GVNEW=replace-with-demo-password-2
EDUVAULT_SEED_PASSWORD_TBM01=replace-with-demo-password-3
EDUVAULT_SEED_PASSWORD_ADMIN=replace-with-demo-password-4

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OCR_MODEL=gpt-4o-mini
OPENAI_OCR_TIMEOUT_SECONDS=180

# Upload / OCR
MAX_UPLOAD_MB=250
MAX_AI_ANALYZE_MB=25
OCR_MAX_PAGES=30
OCR_BATCH_PAGES=4
OCR_RENDER_SCALE=1.8

# Optional cloud sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=replace-with-cloudflare-tunnel-id
# Windows example: C:\Users\<User>\.cloudflared\<TunnelID>.json
# Linux example: /home/<user>/.cloudflared/<TunnelID>.json
CLOUDFLARE_CREDENTIALS_FILE=replace-with-absolute-path-to-cloudflared-json
CLOUDFLARE_FRONTEND_HOSTNAME=eduvault-demo.example.com
CLOUDFLARE_BACKEND_HOSTNAME=api.eduvault-demo.example.com
CLOUDFLARE_FRONTEND_HOSTNAME_ALT=c2-app-012.eduvinuni.io.vn
CLOUDFLARE_BACKEND_HOSTNAME_ALT=c2-app-012-api.eduvinuni.io.vn
