# =========================
# EduVault V4 - Production
# =========================

# Public URL of the deployed platform. Used for OAuth callback derivation.
PUBLIC_BASE_URL=https://khotrithuc.example.edu

# Comma-separated origins allowed to call the backend directly.
# Include the frontend origin and any separate admin/API domains if used.
ALLOWED_ORIGINS=https://khotrithuc.example.edu

# Session cookies should be secure in HTTPS production.
SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=480

# Database
# Fail fast if MySQL is unavailable.
DATABASE_PROVIDER=mysql
DATABASE_FALLBACK_SQLITE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eduvault
MYSQL_USER=eduvault
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_CONNECT_TIMEOUT_SECONDS=3
MYSQL_STARTUP_MAX_WAIT_SECONDS=45
MYSQL_STARTUP_BACKOFF_BASE_SECONDS=0.5
MYSQL_STARTUP_BACKOFF_MAX_SECONDS=5
# Needed by docker-compose/mysql administration, even though the app does not
# read this variable directly.
MYSQL_ROOT_PASSWORD=replace-with-separate-strong-root-password

# File/object storage
MINIO_ENABLED=true
MINIO_ENDPOINT=minio.internal:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
# Needed by docker-compose/minio administration, even though the app uses the
# access/secret pair above at runtime.
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-separate-minio-root-password
MINIO_BUCKET=eduvault
MINIO_SECURE=true

# Queue / vector services
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE=eduvault:v4:jobs
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=eduvault_chunks
RAG_RETRIEVAL_PROVIDER=qdrant
QDRANT_TOP_K=100
OPS_QDRANT_FALLBACK_THRESHOLD=3

# Upload / security / processing
MAX_UPLOAD_MB=250
MAX_AI_ANALYZE_MB=25
PASSWORD_HASH_ITERATIONS=390000
TOKEN_ENCRYPTION_KEY=replace-with-random-32-plus-char-secret
N8N_POLICY_SECRET=replace-with-random-policy-secret
# Optional: if n8n policy approval is deployed, point to the inbound webhook.
N8N_POLICY_WEBHOOK_URL=

# Seed users for first bootstrap only. Rotate or replace immediately after initial setup.
EDUVAULT_SEED_PASSWORD_GV001=replace-with-bootstrap-password-1
EDUVAULT_SEED_PASSWORD_GVNEW=replace-with-bootstrap-password-2
EDUVAULT_SEED_PASSWORD_TBM01=replace-with-bootstrap-password-3
EDUVAULT_SEED_PASSWORD_ADMIN=replace-with-bootstrap-password-4

# AI provider
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OCR_MODEL=gpt-4o-mini
OPENAI_OCR_TIMEOUT_SECONDS=180
OCR_MAX_PAGES=30
OCR_BATCH_PAGES=4
OCR_RENDER_SCALE=1.8

# OAuth cloud sync
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Leave GOOGLE_REDIRECT_URI empty if you want the system to derive it from PUBLIC_BASE_URL.
GOOGLE_REDIRECT_URI=

MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_REDIRECT_URI=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=replace-with-cloudflare-tunnel-id
# Windows example: C:\Users\<User>\.cloudflared\<TunnelID>.json
# Linux example: /home/<user>/.cloudflared/<TunnelID>.json
CLOUDFLARE_CREDENTIALS_FILE=replace-with-absolute-path-to-cloudflared-json
CLOUDFLARE_FRONTEND_HOSTNAME=khotrithuc.example.edu
CLOUDFLARE_BACKEND_HOSTNAME=api.khotrithuc.example.edu

# Optional: only needed for MCP client integrations that talk to this app using
# a copied browser session token.
EDUVAULT_TOKEN=
