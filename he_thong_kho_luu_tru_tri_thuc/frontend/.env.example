# Required for Next.js rewrite proxy in both local and production builds.
# Local example: BACKEND_URL=http://127.0.0.1:8080
# Production example: BACKEND_URL=http://backend:8080
BACKEND_URL=

# Optional: only set this when the browser must call a separately exposed API
# instead of same-origin /api proxy routes.
# NEXT_PUBLIC_API_URL=https://api.example.edu

# Public browser URL of the deployed platform, used by OAuth callback flows.
# Example: PUBLIC_BASE_URL=https://khotrithuc.example.edu
PUBLIC_BASE_URL=

# Comma-separated origins allowed to call the backend directly.
# Example: ALLOWED_ORIGINS=https://khotrithuc.example.edu,https://admin.example.edu
ALLOWED_ORIGINS=

# Production should fail fast when MySQL is down instead of silently falling back.
DATABASE_FALLBACK_SQLITE=false

# Set to true in HTTPS environments so session cookies are marked Secure.
SESSION_COOKIE_SECURE=true
